<mxfile host="app.diagrams.net"><diagram name="Página-1" id="d1"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="enun" value="Un local comercial procesa las compras de sus clientes. Se ingresan pares de datos: cantidad y precio_unitario. El ingreso finaliza cuando la cantidad ingresada sea 0. Si el monto total de una compra supera los $15.000, se aplica un descuento del 10%. Calcular y mostrar el total cobrado por cada cliente y la recaudación general del día." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="380" height="150" as="geometry"/></mxCell><mxCell id="n2" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="682" y="20" width="80" height="80" as="geometry"/></mxCell><mxCell id="n3" value="recaudacion ← 0" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="650" y="140" width="145" height="50" as="geometry"/></mxCell><mxCell id="n5" value="cantidad" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="647" y="230" width="150" height="55" as="geometry"/></mxCell><mxCell id="n7" value="MQ  cantidad != 0" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=25;" vertex="1" parent="1"><mxGeometry x="612" y="325" width="220" height="56" as="geometry"/></mxCell><mxCell id="n8" value="precio_unitario" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="635" y="421" width="175" height="55" as="geometry"/></mxCell><mxCell id="n9" value="monto ← cantidad * precio_unitario" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="583" y="516" width="278" height="50" as="geometry"/></mxCell><mxCell id="n11" value="monto &gt; 15000" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="610" y="606" width="225" height="100" as="geometry"/></mxCell><mxCell id="n14" value="totalCliente ← monto * 0.9" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="764" y="746" width="222" height="50" as="geometry"/></mxCell><mxCell id="n16" value="totalCliente ← monto" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="480" y="746" width="180" height="50" as="geometry"/></mxCell><mxCell id="n18" value="Sí" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="841" y="630" width="30" height="22" as="geometry"/></mxCell><mxCell id="n19" value="No" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="574" y="630" width="30" height="22" as="geometry"/></mxCell><mxCell id="n21" value="recaudacion ← recaudacion + totalCliente" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="562" y="836" width="320" height="50" as="geometry"/></mxCell><mxCell id="n24" value="&quot;Total cobrado al cliente: &quot;, totalCliente" style="strokeWidth=1;html=1;shape=mxgraph.flowchart.display;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="525" y="926" width="394" height="60" as="geometry"/></mxCell><mxCell id="n26" value="cantidad" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="647" y="1026" width="150" height="55" as="geometry"/></mxCell><mxCell id="n29" value="Fin (MQ)" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="657" y="1121" width="130" height="44" as="geometry"/></mxCell><mxCell id="n32" value="&quot;Recaudación general del día: &quot;, recaudacion" style="strok