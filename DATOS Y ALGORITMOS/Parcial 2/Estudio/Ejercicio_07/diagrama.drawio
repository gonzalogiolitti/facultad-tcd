<mxfile host="app.diagrams.net"><diagram name="Página-1" id="d1"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="enun" value="Pregunta 1: diagrama y PseInt&lt;br&gt;Un estacionamiento registra los vehículos del día. Por cada vehículo se ingresa el tipo (A auto, M moto, C camioneta, en mayúscula o minúscula) y, después, las horas de estadía. El ingreso termina cuando el tipo es X; en ese caso no se piden horas.&lt;br&gt;Tarifa por hora: auto $1.500, moto $800, camioneta $2.200.&lt;br&gt;Si la estadía supera las 8 horas, se descuenta el 10% del importe de ese vehículo.&lt;br&gt;Si el tipo no es A, M, C ni X, mostrar &quot;Tipo inválido&quot; y seguir con el próximo vehículo, sin pedir horas.&lt;br&gt;Al final mostrar: la cantidad de autos, de motos y de camionetas; el total recaudado; y el importe más alto cobrado. Si no se registró ningún vehículo, mostrar &quot;Sin movimientos&quot;.&lt;br&gt;Entregás .psc, .drawio y PNG, con el diagrama espejo del código." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="380" height="366" as="geometry"/></mxCell><mxCell id="n2" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="873" y="20" width="80" height="80" as="geometry"/></mxCell><mxCell id="n3" value="autos ← 0&lt;br&gt;motos ← 0&lt;br&gt;camionetas ← 0&lt;br&gt;total ← 0&lt;br&gt;maximo ← 0" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="844" y="140" width="138" height="124" as="geometry"/></mxCell><mxCell id="n5" value="tipo" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="838" y="304" width="150" height="55" as="geometry"/></mxCell><mxCell id="n7" value="tipo ← Mayusculas(tipo)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="812" y="399" width="201" height="50" as="geometry"/></mxCell><mxCell id="n9" value="MQ  tipo != &quot;X&quot;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=25;" vertex="1" parent="1"><mxGeometry x="803" y="489" width="220" height="56" as="geometry"/></mxCell><mxCell id="n10" value="(tipo = &quot;A&quot;) or (tipo = &quot;M&quot;) or (tipo = &quot;C&quot;)" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="653" y="585" width="520" height="120" as="geometry"/></mxCell><mxCell id="n60" value="horas" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="1402" y="745" width="150" height="55" as="geometry"/></mxCell><mxCell id="n61" value="tipo = &quot;A&quot;" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1382" y="840" width="190" height="100" as="geometry"/></mxCell><mxCell id="n72" value="tarifa ← 1500&lt;br&gt;autos ← autos + 1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1532" y="980" width="159" height="64" as="geometry"/></mxCell><mxCell id="n74" value="tipo = &quot;M&quot;" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1127" y="980" width="190" height="100" as="geometry"/></mxCell><mxCell id="n77" value="tarifa ← 800&lt;br&gt;motos ← motos + 1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1278" y="1120" width="159" height="64" as="geometry"/></mxCell><mxCell id="n79" value="tarifa ← 2200&lt;br&gt;camionetas ← camionetas + 1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="953" y="1120" width="229" height="64" as="geometry"/></mxCell><mxCell id="n81" value="Sí" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent