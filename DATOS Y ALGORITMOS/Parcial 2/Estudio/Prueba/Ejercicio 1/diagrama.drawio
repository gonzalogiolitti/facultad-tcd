<mxfile host="app.diagrams.net"><diagram name="Página-1" id="d1"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="enun" value="Ejercicio 3: diagrama y PseInt, con Para&lt;br&gt;Un cine registra las 7 funciones de una semana. Por cada función se ingresan la sala (1 común, 2 VIP) y la cantidad de espectadores.&lt;br&gt;La entrada cuesta $4.000 en la sala 1 y $7.000 en la sala 2.&lt;br&gt;Si hay más de 100 espectadores, se aplica un 15% de descuento sobre la recaudación de esa función.&lt;br&gt;Al final mostrar: la recaudación total, la cantidad de funciones con descuento, la función con más espectadores (su número y la cantidad) y el promedio de espectadores por función.&lt;br&gt;Si hay empate en el máximo, informar la primera.&lt;br&gt;Entregás .psc, .drawio y PNG, con el diagrama espejo del código." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="380" height="294" as="geometry"/></mxCell><mxCell id="n2" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="694" y="20" width="80" height="80" as="geometry"/></mxCell><mxCell id="n3" value="total ← 0&lt;br&gt;conDescuento ← 0&lt;br&gt;sumaEspectadores ← 0&lt;br&gt;maxEspectadores ← -1&lt;br&gt;nroMax ← 0" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="644" y="140" width="180" height="124" as="geometry"/></mxCell><mxCell id="n5" value="Para nroFuncion ← 1 , 7 , 1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=25;" vertex="1" parent="1"><mxGeometry x="594" y="304" width="279" height="56" as="geometry"/></mxCell><mxCell id="n6" value="sala" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="658" y="400" width="150" height="55" as="geometry"/></mxCell><mxCell id="n7" value="espectadores" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="656" y="495" width="154" height="55" as="geometry"/></mxCell><mxCell id="n9" value="sala = 1" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="638" y="590" width="190" height="100" as="geometry"/></mxCell><mxCell id="n12" value="precio ← 4000" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="803" y="730" width="131" height="50" as="geometry"/></mxCell><mxCell id="n14" value="precio ← 7000" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="533" y="730" width="131" height="50" as="geometry"/></mxCell><mxCell id="n16" value="Sí" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="834" y="614" width="30" height="22" as="geometry"/></mxCell><mxCell id="n17" value="No" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="602" y="614" width="30" height="22" as="geometry"/></mxCell><mxCell id="n19" value="recaudacion ← espectadores * precio" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="591" y="820" width="285" height="50" as="geometry"/></mxCell><mxCell id="n22" value="espectadores &gt; 100" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="591" y="910" width="284" height="100" as="geometry"/></mxCell><mxCell id="n24" value="recaudacion ← recaudacion * 0.85&lt;br&gt;conDescuento ← conDescuento + 1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="784" y="1050" width="264" height="64" as="geometry"/></mxCell><mxCell id="n26" value="Sí" style="text;html=1;strokeColor=none;fillColor=none;align=center;vert