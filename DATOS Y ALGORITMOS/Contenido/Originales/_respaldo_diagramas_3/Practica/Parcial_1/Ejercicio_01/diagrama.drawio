<mxfile host="app.diagrams.net"><diagram name="Página-1" id="d1"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="enun" value="Ejercicio 01&lt;br&gt;Se desea analizar las ventas de 30 días de un minimarket. Para ello se debe solicitar cuál es el objetivo diario (monto total de venta diaria en pesos) y a partir de ello, para cada día leer montoVenta.&lt;br&gt;- Si montoVenta &gt;= objetivoDiario, contar &quot;día cumplido&quot;.&lt;br&gt;- Acumular ventasTotales.&lt;br&gt;- Al final, mostrar días cumplidos del objetivo diario y las ventas totales de los 30 días." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="380" height="204" as="geometry"/></mxCell><mxCell id="n2" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="682" y="20" width="80" height="80" as="geometry"/></mxCell><mxCell id="n3" value="diasCumplidos ← 0&lt;br&gt;ventasTotales ← 0" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="642" y="140" width="159" height="64" as="geometry"/></mxCell><mxCell id="n5" value="objetivoDiario" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="638" y="244" width="168" height="55" as="geometry"/></mxCell><mxCell id="n7" value="Para dia ← 1 , 30 , 1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=25;" vertex="1" parent="1"><mxGeometry x="603" y="339" width="237" height="56" as="geometry"/></mxCell><mxCell id="n8" value="montoVenta" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="647" y="435" width="150" height="55" as="geometry"/></mxCell><mxCell id="n9" value