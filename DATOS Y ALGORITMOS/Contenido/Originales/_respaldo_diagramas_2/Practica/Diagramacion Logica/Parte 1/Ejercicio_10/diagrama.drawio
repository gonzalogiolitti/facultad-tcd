<mxfile host="app.diagrams.net"><diagram name="Página-1" id="d1"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="enun" value="Ejercicio 10&lt;br&gt;Se lee desde el teclado el valor de un ángulo en grados. Se desea mostrar el coseno y el seno de dicho ángulo." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="380" height="96" as="geometry"/></mxCell><mxCell id="n2" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="579" y="20" width="80" height="80" as="geometry"/></mxCell><mxCell id="n3" value="pi_valor ← 3.1416" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="159" height="50" as="geometry"/></mxCell><mxCell id="n5" value="angulo" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="544" y="230" width="150" height="55" as="geometry"/></mxCell><mxCell id="n7" value="radianes ← angulo * pi_valor / 180&lt;br&gt;coseno ← cos(radianes)&lt;br&gt;seno ← sen(radianes)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="480" y="325" width="278" height="84" as="geometry"/></mxCell><mxCell id="n9" value="&quot;El coseno es: &quot;, coseno" style="shape=display;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="485" y="449" width="268" height="60" as="geometry"/></mxCell><mxCell id="n11" value="&quot;El seno es: &quot;, seno" style="shape=display;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="499" y="549" width="240" height="60" as="geometry"/></mxCell><mxCell id="n13" value="Fin" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="579" y="649