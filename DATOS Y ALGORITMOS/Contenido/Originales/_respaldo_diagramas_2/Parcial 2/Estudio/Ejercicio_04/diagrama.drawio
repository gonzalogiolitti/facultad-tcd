<mxfile host="app.diagrams.net"><diagram name="Página-1" id="d1"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="enun" value="Ejercicio 04&lt;br&gt;Un gimnasio registra la asistencia de sus socios durante 30 días. Para cada día se ingresa la cantidad de socios que asistieron.&lt;br&gt;Un día es “lleno” si asistieron más de 80 socios. Contar los días llenos.&lt;br&gt;Acumular el total de asistencias del mes.&lt;br&gt;Registrar el día con menos asistencia (el número de día, no solo la cantidad).&lt;br&gt;Salidas:&lt;br&gt;“Días llenos: ...”&lt;br&gt;“Total de asistencias: ...”&lt;br&gt;“Día con menos asistencia: ...”&lt;br&gt;Si ningún día fue lleno, mostrar además “Ningún día lleno”." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="380" height="294" as="geometry"/></mxCell><mxCell id="n2" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="740" y="20" width="80" height="80" as="geometry"/></mxCell><mxCell id="n3" value="diasLlenos ← 0&lt;br&gt;totalAsistencias ← 0&lt;br&gt;menorAsistencia ← 0&lt;br&gt;diaMenor ← 0" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="690" y="140" width="180" height="104" as="geometry"/></mxCell><mxCell id="n5" value="Para dia ← 1 , 30 , 1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=25;" vertex="1" parent="1"><mxGeometry x="662" y="284" width="237" height="56" as="geometry"/></mxCell><mxCell id="n6" value="asistencia" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="705" y="380" width="150" height="55" as="geometry"/></mxCell><mxCell id="n7" value="totalAsistencias ← totalAsistencias + asistencia" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="592" y="475" width="376" height="50" as="geometry"/></mxCell><mxCell id="n9" value="asistencia &gt; 80" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="656" y="565" width="248" height="100" as="geometry"/></mxCell><mxCell id="n11" value="diasLlenos ← diasLlenos + 1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="830" y="705" width="229" height="50" as="geometry"/></mxCell><mxCell id="n13" value="Sí" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="910" y="589" width="30" height="22" as="geometry"/></mxCell><mxCell id="n14" value="No" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="620" y="589" width="30" height="22" as="geometry"/></mxCell><mxCell id="n16" value="dia = 1 O asistencia &lt; menorAsistencia" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="520" y="795" width="520" height="120" as="geometry"/></mxCell><mxCell id="n18" value="menorAsistencia ← asistencia&lt;br&gt;diaMenor ← dia" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="962" y="955" width="236" height="64" as="geometry"/></mxCell><mxCell id="n20" value="Sí" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1046" y="829" width="30" height="22" as="geometry"/></mxCell><mxCell id="n21" value="No" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="484" y="829" width="30" height="22" as="geometry"/></mxCell><mxCell id="n25" value="Fin (Para)" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="715" y="1059" width="130" height="44" as="geometry"/></mxCell><mxCell id="n29" value="&quot;Días llenos: &quot;, diasLlenos" style="shape=display;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="636" y="1143" width="289" height="60" as="geometry"/></mxCell><mxCell id="n31" value="&quot;Total de asistencias: &quot;, totalAsistencias" style="shape=display;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="583" y="1243" width="394" height="60" as="geometry"/></mxCell><mxCell id="n33" value="&quot;Día con menos asistencia: &quot;, diaMenor" style="shape=display;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="597" y="1343" width="366" height="60" as="geometry"/></mxCell><mxCell id="n35" value="diasLlenos = 0" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="662" y="1443" width="237" height="100" as="geometry"/></mxCell><mxCell id="n37" value="&quot;Ningún día lleno&quot;" style="shape=display;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="825" y="1583" width="226" height="60" as="geometry"/></mxCell><mxCell id="n39" value="Sí" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="904" y="1467" width="30" height="22" as="geometry"/></mxCell><mxCell id="n40" value="No" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="626" y="1467" width="30" height="22" as="geometry"/></mxCell><mxCell id="n42" value="Fin" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="740" y="1683" width="80" height="80" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" style="edgeStyle=orthogonalEdgeStyl