  <diagram name="Ejercicio 08" id="diag">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2400" math="0" shadow="0" background="#000000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="enunciado" value="&lt;b&gt;Enunciado&lt;/b&gt;&lt;br&gt;&lt;br&gt;Una fábrica desea controlar la calidad de dos piezas, A y B de las cuales se dan como dato el tipo de pieza y su medida en milímetros. Se debe indicar si la pieza cumple con las especificaciones de calidad que son las siguientes:&lt;br&gt;- Las piezas tipo A deben medir 165 mm y se admite un error de +/- 2 mm&lt;br&gt;- Las piezas tipo B deben medir 180 mm y se admite un error de +/- 3 mm" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="-1511" y="0" width="420" height="251" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FFFFFF;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="-40.0" y="0.0" width="80.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Leer tipo, medida" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#000000;strokeColor=#FFFFFF;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="-106.3" y="130.0" width="212.6" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="¿tipo = &quot;A&quot;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FFFFFF;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="-105.0" y="234.0" width="210.0" height="100.0" as="geometry" />
        </mxCell>
