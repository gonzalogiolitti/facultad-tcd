<mxfile host="app.diagrams.net"><diagram name="Página-1" id="d1"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="enun" value="Ejercicio 5: diagrama y PseInt, con Mientras&lt;br&gt;Un cajero automático arranca el día con un saldo de $50.000, que se ingresa al inicio. Se ingresan los montos de las extracciones hasta que se ingrese 0 o un monto negativo, que cortan el ingreso y no se procesan.&lt;br&gt;Si el monto es mayor al saldo disponible, mostrar &quot;Fondos insuficientes&quot; y no descontar nada.&lt;br&gt;Si no, descontar el monto del saldo y contar la extracción como válida.&lt;br&gt;Al final mostrar: la cantidad de extracciones válidas, la cantidad de rechazadas, el saldo final y la extracción válida más alta.&lt;br&gt;Si no hubo ninguna válida, mostrar &quot;Sin extracciones&quot; en vez de la más alta.&lt;br&gt;Entregás .psc, .drawio y PNG, con el diagrama espejo del código." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="380" height="330" as="geometry"/></mxCell><mxCell id="n2" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="866" y="20" width="80" height="80" as="geometry"/></mxCell><mxCell id="n3" value="validas ← 0&lt;br&gt;rechazadas ← 0&lt;br&gt;maxima ← 0" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="837" y="140" width="138" height="84" as="geometry"/></mxCell><mxCell id="n5" value="saldo" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="831" y="264" width="150" height="55" as="geometry"/></mxCell><mxCell id="n7" value="monto" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="831" y="359" width="150" height="55" as="geometry"/></mxCell><mxCell id="n9" value="MQ  monto &gt; 0" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=25;" vertex="1" parent="1"><mxGeometry x="796" y="454" width="220" height="56" as="geometry"/></mxCell><mxCell id="n10" value="monto &gt; saldo" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="793" y="550" width="225" height="100" as="geometry"/></mxCell><mxCell id="n22" value="&quot;Fondos insuficientes&quot;" style="strokeWidth=1;html=1;shape=mxgraph.flowchart.display;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="946" y="690" width="254" height="60" as="geometry"/></mxCell><mxCell id="n23" value="rechazadas ← rechazadas + 1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="958" y="790" width="229" height="50" as="geometry"/></mxCell><mxCell id="n26" value="saldo ← saldo - monto&lt;br&gt;validas ← validas + 1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="545" y="690" width="187" height="64" as="geometry"/></mxCell><mxCell id="n27" value="monto &gt; maxima" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="520" y="794" width="237" height="100" as="geometry"/></mxCell><mxCell id="n29" value="maxima ← monto" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="728" y="934" width="138" height="50" as="geometry"/></mxCell><mxCell id="n31" value="Sí" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="763" y="818" width="30" height="22" as="geometry"/></mxCell><mxCell id="n32" value="No" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="484" y="818" width="30" height="22" as="geometry"/></mxCell><mxCell id="n35" value="Sí" style="text;html=1;strokeCo