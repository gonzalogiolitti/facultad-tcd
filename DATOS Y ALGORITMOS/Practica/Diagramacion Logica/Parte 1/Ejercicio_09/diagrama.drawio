<mxfile host="app.diagrams.net"><diagram name="Página-1" id="d1"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="enun" value="Ejercicio 09&lt;br&gt;Se ingresa por teclado la categoría de un socio del club deportivo Sol Naciente (A, B o C) y su antigüedad en años. Si el socio tiene categoría A, o su antigüedad se encuentra entre los 10 y los 20 años, mostrar el cartel &quot;Socio vip&quot;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="380" height="132" as="geometry"/></mxCell><mxCell id="n2" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="740" y="20" width="80" height="80" as="geometry"/></mxCell><mxCell id="n3" value="categoria,antiguedad" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="675" y="140" width="210" height="55" as="geometry"/></mxCell><mxCell id="n5" value="categoria = &quot;A&quot; O (antiguedad &gt;= 10 Y antiguedad &lt;= 20)" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="520" y="235" width="520" height="120" as="geometry"/></mxCell><mxCell id="n7" value="&quot;Socio vip&quot;" style="shape=display;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="992" y="395" width="177" height="60" as="geometry"/></mxCell><mxCell id="n9" value="Sí" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1046" y="269" width="30" height="22" as="geometry"/></mxCell><mxCell id="n10" value="No" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="484" y