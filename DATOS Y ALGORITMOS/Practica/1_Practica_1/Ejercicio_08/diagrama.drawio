<mxfile host="app.diagrams.net"><diagram name="Página-1" id="d1"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="enun" value="Ejercicio 08&lt;br&gt;Una fábrica desea controlar la calidad de dos piezas, A y B de las cuales se dan como dato el tipo de pieza y su medida en milímetros. Se debe indicar si la pieza cumple con las especificaciones de calidad que son las siguientes:&lt;br&gt;- Las piezas tipo A deben medir 165 mm y se admite un error de +/- 2 mm&lt;br&gt;- Las piezas tipo B deben medir 180 mm y se admite un error de +/- 3 mm" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="380" height="204" as="geometry"/></mxCell><mxCell id="n2" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1672" y="20" width="80" height="80" as="geometry"/></mxCell><mxCell id="n3" value="tipo,medida" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="1637" y="140" width="150" height="55" as="geometry"/></mxCell><mxCell id="n5" value="tipo = &quot;A&quot;" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1617" y="235" width="190" height="100" as="geometry"/></mxCell><mxCell id="n40" value="medida &gt;= 163 Y medida &lt;= 167" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1971" y="375" width="415" height="100" as="geometry"/></mxCell><mxCell id="n43" value="&quot;La pieza A cumple con la calidad&quot;" style="shape=display;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="2257" y="515" width="338" height="60" as="geometry"/></mxCell><mxCell id="n45" value="&quot;La pieza A NO cumple con la calidad&quot;" style="shape=