<mxfile host="app.diagrams.net"><diagram name="Página-1" id="d1"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="enun" value="Ejercicio 05&lt;br&gt;Dado el importe bruto de una factura calcular el resultado de bonificarlo con un 4%. Al monto obtenido calcularle el IVA. Finalmente informar el importe bruto, el valor de la bonificación, el importe bruto bonificado, el monto correspondiente al IVA y el importe neto resultante." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="380" height="150" as="geometry"/></mxCell><mxCell id="n2" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="651" y="20" width="80" height="80" as="geometry"/></mxCell><mxCell id="n3" value="tasa_bonif ← 0.04&lt;br&gt;tasa_iva ← 0.21" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="612" y="140" width="159" height="64" as="geometry"/></mxCell><mxCell id="n5" value="bruto" style="shape=manualInput;whiteSpace=wrap;html=1;size=15;" vertex="1" parent="1"><mxGeometry x="616" y="244" width="150" height="55" as="geometry"/></mxCell><mxCell id="n7" value="bonificacion ← bruto * tasa_bonif&lt;br&gt;bruto_bonificado ← bruto - bonificacion&lt;br&gt;iva ← bruto_bonificado * tasa_iva&lt;br&gt;neto ← bruto_bonificado + iva" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="534" y="339" width="313" height="104" as="geometry"/></mxCell><mxCell id="n9" value="&quot;Importe bruto: &quot;, bruto" style="shape=display;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="557" y="483" width="268" height="60" as="geometry"/></mxCell><mxCell id="n11" value="&quot;Bonificación: &quot;, bonificacion" s