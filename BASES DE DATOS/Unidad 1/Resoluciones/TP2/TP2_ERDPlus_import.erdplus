      {
        "id": "0bce1b5b-1603-425c-ad25-1ef47d858284",
        "type": "Label",
        "position": {
          "x": 40,
          "y": 1098
        },
        "data": {
          "label": "TP2 · Estudio de Caso 2 — Sistema de Reservas de Autos\n\nReservas de una empresa de alquiler de autos. De un\ncliente: DNI, nombre, dirección (puede haber clientes sin\nreservas). De una reserva: número único, descripción,\nfecha de comienzo y fecha final; la realiza un único\ncliente pero involucra varios coches. De un coche: modelo,\nmarca, patente (única); tiene siempre asignado un garage\nfijo (no cambia). De un garage: número único y dirección.\nCada reserva se realiza en una agencia (número único,\nnombre, dirección).",
          "isSelected": false,
          "isConnectable": true
        },
        "measured": {
          "width": 470,
          "height": 240
        },
        "selected": false,
        "dragging": false
      },
