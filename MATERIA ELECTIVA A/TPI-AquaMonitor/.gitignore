# --- Entorno / credenciales ---
.env
*.env
!.env.example
!.env.example.*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Salidas generadas ---
_archivo/stack_anterior/analisis/outputs/*.csv
_archivo/stack_anterior/analisis/outputs/*.png
*.log

# --- Editores / SO ---
*:Zone.Identifier
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Node-RED (datos locales de runtime) ---
nodered/.node-red-data/
*_cred.json
nodered/userdir/node_modules/
nodered/userdir/context/
nodered/userdir/.sessions.json
nodered/userdir/lib/
nodered/userdir/.nodered.pid
nodered/userdir/nodered.log
.config.*.json

# --- El .gitignore de la raiz del repo solo deja pasar md/txt/csv/json/xlsx:
#     aca se re-incluye el codigo y la configuracion de este proyecto ---
!*.py
!*.sql
!*.yml
!*.yaml
!Dockerfile
!*.js
!*.sh
!*.ps1
