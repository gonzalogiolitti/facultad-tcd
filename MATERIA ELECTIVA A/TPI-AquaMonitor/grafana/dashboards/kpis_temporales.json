          "rawSql": "SELECT ts AS time, kpi_name AS metric, value FROM kpi_values WHERE equipo = 'EQ01' AND kpi_name = 'eficiencia_energetica' AND period = '${period}' AND $__timeFilter(ts) ORDER BY ts",
