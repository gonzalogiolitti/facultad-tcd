      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${datasource}"
          },
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, value FROM raw_variables WHERE tag = 'AQM-PTEF-CAPT-EQ01-ESTADO' AND $__timeFilter(ts) ORDER BY ts",
          "format": "time_series"
