# =============================================================================
#  AquaMonitor - stack de la catedra
#  Node-RED (local, npm) -> InfluxDB Cloud Serverless -> Grafana Cloud + mail
# =============================================================================
#  Copiar este archivo a `.env` y completar los valores.
#  `.env` NO se versiona (esta en .gitignore). Este archivo (.env.example) si,
#  por eso NO lleva ningun valor secreto.
#  Node-RED lee estas variables del entorno al arrancar (ver script de arranque).
# =============================================================================

# --- InfluxDB Cloud (Serverless) --------------------------------------------
# URL de la region de tu cuenta, sin barra final.
INFLUX_URL=
# Nombre de la organizacion (InfluxDB UI > menu de usuario > About).
INFLUX_ORG=
# Bucket (en la UI de InfluxDB 3 se muestra como "database").
INFLUX_BUCKET=
# SECRETO. Token de API con permiso de ESCRITURA sobre el bucket.
# (InfluxDB UI > Load Data > API Tokens). Solo lo usa Node-RED para escribir.
INFLUX_TOKEN=

# --- Mail (Gmail con contrasena de aplicacion) -------------------------------
SMTP_HOST=
# 465 con SMTP_SECURE=true, o 587 con SMTP_SECURE=false (STARTTLS).
SMTP_PORT=
SMTP_SECURE=
# Cuenta de Gmail que envia los avisos.
SMTP_USER=
# SECRETO. Contrasena de APLICACION de 16 letras (Cuenta de Google >
# Seguridad > Verificacion en 2 pasos > Contrasenas de aplicacion).
# NO es la contrasena normal de la cuenta.
SMTP_PASSWORD=
# Remitente que se ve en el mail (normalmente igual a SMTP_USER).
ALERT_MAIL_FROM=
# Destinatario de las alertas de falla.
ALERT_MAIL_TO=
# Destinatario del reporte diario.
REPORTE_MAIL_TO=

# --- Ajustes del generador y de los avisos (NO son secretos) -----------------
# Estos ajustes tienen un valor por defecto dentro de los flows: solo hace
# falta definirlos si queres cambiarlos.
# Segundos entre mediciones en modo normal (la consigna pide 2 a 5 min = 120 a 300).
#GEN_INTERVALO_S=120
# Segundos entre mediciones en modo demo (solo para mostrar en vivo).
#GEN_INTERVALO_DEMO_S=15
# Segundos seguidos en valores normales para dar la falla de la bomba por terminada.
#ALERTA_REARME_S=60
# Tiempo minimo entre dos mails por la misma variable de EQ02/EQ03 (flow 03).
#ALERTA_COOLDOWN_S=1800
